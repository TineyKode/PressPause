{
  "manifest_version": 3,
  "name": "PressPause",
  "version": "1.1.0",
  "description": "A focused work rhythm timer with break reminders.",
  "permissions": ["alarms", "notifications", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PressPause",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
